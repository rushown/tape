# ── Mode ────────────────────────────────────────────────────────────────
# self   = one trader: the app sends APP_TOKEN, the exchange is set below (default)
# hosted = a public service: anyone starts a paper account or connects their own
#          Bybit testnet/demo key in the app. Data in SQLite. See deploy/README.md
TAPE_MODE=self

# self: shared secret the glasses app sends. Generate: openssl rand -hex 24
APP_TOKEN=

# hosted: encrypts users' API keys at rest. Generate: openssl rand -hex 32 (keep a copy safe)
DATA_KEY=
# hosted: new accounts per IP per hour, and how many desks may poll at once
SIGNUP_LIMIT_PER_HOUR=5
MAX_LOADED_DESKS=300

# ── Exchange (self mode; hosted users choose in the app) ────────────────
# paper = simulated account on live public prices, no keys needed (default)
# bybit = your Bybit TESTNET (testnet.bybit.com) or DEMO TRADING account.
#         Mainnet is not supported, on purpose.
EXCHANGE=paper
BYBIT_ENV=testnet
# Create on testnet.bybit.com → API → System-generated key.
# Permissions: Contracts (Orders, Positions) + Wallet (Account Transfer). Read-write. No withdrawals.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Paper account
PAPER_START_USDT=10000
PAPER_LEVERAGE=10
PAPER_FEE_BPS=5.5
# auto = real public prices (Bybit, then Binance, then OKX); never made up.
# synthetic = offline random walk, labelled "simulated", for demos without internet only.
PRICE_SOURCE=auto

# ── Safety ──────────────────────────────────────────────────────────────
# No order or transfer above this, whatever is said. Users can lower it in the app, never raise it.
MAX_ORDER_USD=2500
# 1 = start read-only (prices, PnL and alerts; no trading)
READ_ONLY=0
# A confirm card on the glasses is valid this many seconds
PLAN_TTL_S=30
WATCHLIST=BTC,ETH,SOL,XRP
POLL_MS=3000

# ── Speech-to-text (any OpenAI-compatible /audio/transcriptions server) ──
# Local: docker compose up whisper (speaches). Hosted: Groq / OpenAI with STT_API_KEY.
STT_PROVIDER=whisper
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=
STT_LANGUAGE=en

# ── Server ──────────────────────────────────────────────────────────────
PORT=8791
HOST=0.0.0.0
# Comma-separated list of allowed web origins, or * while developing
CORS_ORIGINS=*
DATA_DIR=./data
LOG_LEVEL=info
PRETTY_LOGS=1
